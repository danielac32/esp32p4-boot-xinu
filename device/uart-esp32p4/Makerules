# Name of this component (the directory this file is stored in)
COMP = device/uart-esp32p4

# Source files for this component
C_FILES = kgetc.c                \
	  kputc.c                \
	  uartHwInit.c           \
	  uartHwPutc.c           \
	  uartHwStat.c           \
	  uartInterrupt.c        \
	  uartWrite.c            \
	  ../uart/uartControl.c  \
	  ../uart/uartGetc.c     \
	  ../uart/uartInit.c     \
	  ../uart/uartPutc.c     \
	  ../uart/uartRead.c     \
	  ../uart/uartStat.c     \
	  ../uart/kprintf.c      \
	  ../uart/kvprintf.c
S_FILES =

# Add the files to the compile source path
DIR = ${TOPDIR}/${COMP}
COMP_SRC += ${S_FILES:%=${DIR}/%} ${C_FILES:%=${DIR}/%}
