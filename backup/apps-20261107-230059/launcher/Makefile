# Makefile del launcher: el mismo talle del ejemplo (launcher.c + las librerias
# de gestos y de banda de estado + start.S, enlazados con 'ld -r').  Ver
# apps/ejemplo/Makefile para el por que de cada bandera del ABI.

TOPDIR = ../../../..

CC = riscv32-unknown-elf-gcc
LD = riscv32-unknown-elf-ld

CFLAGS = -Os -fno-builtin -fno-pic -ffunction-sections -std=gnu11 \
         -march=rv32imaf_zicsr_zifencei -mabi=ilp32f -mno-relax \
         -msmall-data-limit=0 -Wall \
         -I$(TOPDIR) -I$(TOPDIR)/include -I$(TOPDIR)/lvgl -I$(TOPDIR)/fatfs \
         -I$(TOPDIR)/system/platforms/esp32p4 -I../lib

APP  = launcher
OBJS = launcher.o ../lib/gestos.o ../lib/estado.o ../lib/start.o

all: $(APP).elf

$(APP).elf: $(OBJS)
	$(LD) -r -o $@ $(OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

../lib/gestos.o: ../lib/gestos.c ../lib/gestos.h
	$(CC) $(CFLAGS) -c -o $@ $<

../lib/estado.o: ../lib/estado.c ../lib/estado.h
	$(CC) $(CFLAGS) -c -o $@ $<

../lib/start.o: ../lib/start.S
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f launcher.o ../lib/gestos.o ../lib/estado.o ../lib/start.o launcher.elf

.PHONY: all clean
