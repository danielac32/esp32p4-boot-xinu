#
# Platform-specific Makefile definitions for the ESP32-P4 port
# (Waveshare ESP32-P4-WIFI6-Touch-LCD-3.5)
#

# Include default RISCV32 definitions (the P4 is RV32: rv32imafdc)
include arch/riscv32/platformVars

PLATFORM_NAME := ESP32-P4

# The P4 is rv32imafdc / ilp32f (same ISA the SDK uses for the HP core).
CFLAGS   += -march=rv32imafc_zicsr_zifencei -mabi=ilp32f -O2 -ffreestanding
ASFLAGS  += -march=rv32imafc_zicsr_zifencei -mabi=ilp32f

# Add a define so we can test for the ESP32-P4 in C code if absolutely needed
DEFS     += -D_XINU_PLATFORM_ESP32P4_

# esp-hosted's SDIO transport guards on TARGET_SOC_ESP32P4
DEFS     += -DTARGET_SOC_ESP32P4

# W2.d: trazas de la capa de control esp_hosted (espHostedCtrl.c).  El fichero
# es copia verbatim del SDK y ya trae su propio guardagolopes: con
# ESP_HOSTED_CTRL_DEBUG a 1 imprime por que TLV/RPC pasa en cada trama RX y en
# cada peticion.  APAGADAS: el RPC de control y la asociacion del STA ya estan
# verificados en placa, y con la pila TCP/IP encima el volumen de tramas hace
# ilegible la consola.
#DEFS     += -DESP_HOSTED_CTRL_DEBUG=1

# Mis trazas para el motor SDIO (espHostedSdio.c): con DEBUG a 1 imprime cada
# trama RX parseada y cada TX, ademas de los pasos del attach.  El macro que
# usa es el mismo #ifndef ESP_HOSTED_SDIO_DEBUG que trae el fichero de referencia.
# APAGADAS por lo mismo (ambas tienen su default 0 en el .c).
#DEFS     += -DESP_HOSTED_SDIO_DEBUG=1

# Trazas del cliente DHCP (network/dhcpc/dhcp.h): con este define activo
# dhcpClient/dhcpSendRequest/dhcpRecvReply imprimen por donde pasan y por que
# fallan.  APAGADA: `netup' por DHCP esta cerrado (DESCOFFER->REQUEST->ACK y
# la IP de la AP en placa), y las lineas de traza ensuciaban el arranque de
# red.  Se vuelve a activar si el DHCP falla.
#DEFS     += -DENABLE_DHCP_TRACE

# LVGL vuelve dentro del arbol (2026-11-05) PERO SIN el JVM: es la libreria
# sobre la que se escriben las apps en C, asi que sus simbolos tienen que estar
# enlazados en el kernel para poder exportarlos (system/exports.c).  Necesita su
# propio directorio en el include path para que lv_conf_internal.h resuelva
# __has_include("lv_conf.h"); sin eso cae en la ruta relativa "../../lv_conf.h",
# que no existe desde el directorio de compilacion.
# Ojo al orden con include/lvgl.h (el header del DEVICE lvgl): INCLUDE pone
# primero -I$(TOPDIR)/include, asi que un `#include <lvgl.h>' es el del device,
# y la libreria se alcanza por la ruta larga `lvgl/lvgl.h' (-I$(TOPDIR) ya
# estaba).  El puerto esta en device/lvgl/lvglport.c.
INCLUDE  += -I$(TOPDIR)/lvgl

# The FAT file system library lives in fatfs/ and uses <fat_table.h>-style
# includes relative to its own directory.
INCLUDE  += -I$(TOPDIR)/fatfs

# FAT library hook: exposes fl_get_fs() (used by fatfs/fat_rmdir.c).
DEFS     += -DFATFS_INC_TEST_HOOKS

# lwIP (vendored): public headers + lwipopts.h/arch/cc.h from its port dir.
#DISABLED: lwip no forma parte del build minimo.
#INCLUDE  += -I$(TOPDIR)/lwip/include -I$(TOPDIR)/lwip/port/include

# Shims for the ported esp-hosted/lwIP code (delay.h/mtimer.h/usb_serial.h).
#DISABLED: lwip no forma parte del build minimo.
#INCLUDE  += -I$(TOPDIR)/drivers/net/compat

# esp-hosted headers (esp_hosted.h/...): wifi.c in drivers/net includes them.
#DISABLED: esp-hosted no forma parte del build minimo.
#INCLUDE  += -I$(TOPDIR)/drivers/sdio

# Embedded Xinu components to build into the kernel image.
# CLEAN MINIMAL BOOT: the shell and the FAT library (fatfs/) it drives.
# W3: `network' es la pila nativa de Xinu (arp/ipv4/icmp/route/dhcpc/net),
# portada de /home/daniel/xinu-s3-amp.  Sus ficheros se activan con NETHER
# (definido en xinu.conf); los sockets TCP/UDP/raw viven en device/ y van en
# DEVICES.  `mailbox' acompaña a la pila: arpInit/icmpInit/rtInit mensajean por
# mailboxAlloc/mailboxSend/mailboxReceive.
APPCOMPS := shell apps fatfs network mailbox lvgl

# Extra static libraries linked into the kernel (built from lib/<name>/).

# Linking data files across ABIs needs this
LDFLAGS  += --no-warn-mismatch

# El runtime del compilador NO viene de libgcc.a: viene del mask ROM (ver
# compile/platforms/esp32p4/ld.script, grupo `libgccdf').  Antes se enlazaba
# -lgcc y con eso la capa de control esp_hosted (espHostedCtrl.c) conseguia
# __ashldi3 para sus varints protobuf de 64 bits --el core es RV32IMAFDC pero
# el -march del build omite 'd' y 'c', asi que gcc no puede hacer `x << s' en
# linea y llama a la helper.
#
# Se quita -lgcc porque esa multilib esta construida con D y C: sus rutinas df
# cargan el doble con `fld`, que en el P4 es instruccion ILEGAL (lo demostro
# `java FloatTest': mcause=2 en __fixunsdfsi, mtval=0x7a07b787).  Y PROVIDE no
# protege: el alias del ROM no impide que ld abra el archivo, y la definicion
# fuerte del miembro pisa el alias (__divdf3 acabo estando en flash pese a
# estar aliasado).  Sin -lgcc, si algun dia gcc pide una helper que el ROM no
# exporta, el enlace falla con "undefined reference" en lugar de colgar la
# placa a los 20 segundos; las que faltan se escriben entonces en
# lib/libxc/compiler_rt.c, como ya se hizo con __truncdfsf2.
LDLIBS   +=

# Embedded Xinu device drivers to build into the kernel image.
# CLEAN MINIMAL BOOT: serial driver (tty over UART0) + PSRAM (memory/stack)
# + nam (syntactic namespace: mounts /dev/<name> and lists them at boot)
# + lcd-esp32p4 (ST7796 320x480 panel over the SPI2 master)
# + sdmmc-esp32p4 (SDMMC host: pads, clock tree, command engine, IDMAC)
# + sdblock-esp32p4 (the microSD card: SD protocol over the SDMMC host)
# + fat (the FAT volume on that card; the library lives in fatfs/)
# + touch (FT6336 capacitive panel hanging off the shared I2C0 bus)
# + power (AXP2101 PMIC on that same bus; battery gauge, read-only)
# + audio (ES8311 codec on that same bus; I2C control only until the I2S stage).
# + sdio-esp32p4 (W1: SDIO enumeration probe of the ESP32-C6 on slot 1 of the
#   shared SDMMC host; not a devtab device yet, only compiled in for the probe).
# + espeth-esp32p4 (W3: ETH0, el C6 como interfaz Ethernet cruda para la pila
#   nativa; reusa el transporte esp_hosted de sdio-esp32p4).
# + raw / udp / tcp (W3: los sockets de la pila nativa de Xinu; cada instancia
#   del devtab es una entrada de su tabla, rawtab/udptab/tcptab).
# + lvgl: DENTRO otra vez (2026-11-05), pero solo como libreria del kernel: lo
#   que se aparco con ella (el JVM, device/jvm, el launcher y las apps java)
#   sigue en parked/java-gui/.  Sin lvgl enlazado no hay simbolos lv_* que
#   exportar a las apps ELF.
# + jvm: APARCADO en parked/java-gui/ (ver su README.md).
DEVICES  := tty uart-esp32p4 psram nam lcd-esp32p4 sdmmc-esp32p4 sdblock-esp32p4 fat gpio i2c touch power lvgl audio sdio-esp32p4 espeth-esp32p4 raw udp tcp telnet

# ============================================================================
# Imágenes de arranque del P4: SBL (bootloader de 2ª etapa) y ULP (firmware
# del coprocesador LP). Son binarios independientes del ELF del kernel; los
# construye machine/Makefile con su propia toolchain, linker scripts y flags.
# El SBL inicializa el SoC (WDT, clock, PSRAM, MMU), arranca el LP core y salta
# al kernel en 0x40005000.
#
# Al ser prerequisites de $(BOOTIMAGE), un `make' normal construye las tres
# imágenes; `make sbl' / `make ulp' construyen solo una de ellas.
# ============================================================================
MACHINE_DIR := $(TOPDIR)/machine
SBL_BIN     := $(MACHINE_DIR)/build/sbl.bin
ULP_BIN     := $(MACHINE_DIR)/build/ulp.bin

# esptool interviene dos veces: elf2image del SBL (en machine/) y el flasheo.
# No siempre está en el PATH (suele vivir en el venv de ESP-IDF), así que es
# parametrizable; compile/Makefile exporta todas las variables al sub-make, de
# modo que el valor llega también a machine/Makefile:
#
#   make ESPTOOL=$HOME/esp-idf-py/bin/esptool
#
ESPTOOL    ?= esptool

# Fuentes de las que dependen las imágenes (rebuild si cambia cualquiera).  Los
# wildcards cubren los .c/.S/.h/.ld y la libpsram.a de cada imagen.
MACHINE_SRCS := $(MACHINE_DIR)/Makefile \
                $(wildcard $(MACHINE_DIR)/sbl/*) \
                $(wildcard $(MACHINE_DIR)/ulp/*)

$(SBL_BIN): $(MACHINE_SRCS)
	@echo -e "\tBuilding SBL"
	@$(MAKE) -s -C $(MACHINE_DIR) sbl

$(ULP_BIN): $(MACHINE_SRCS)
	@echo -e "\tBuilding ULP"
	@$(MAKE) -s -C $(MACHINE_DIR) ulp

.PHONY: sbl ulp machineclean
sbl: $(SBL_BIN)
ulp: $(ULP_BIN)

# `make clean' NO borra machine/build a propósito: el SBL y el ULP residen en
# la flash y rara vez cambian (se suben con `make flash'), y reconstruir el SBL
# necesita esptool.  `make realclean' sí elimina las tres imágenes.
machineclean:
	@$(MAKE) -s -C $(MACHINE_DIR) clean

PLATCLEAN := machineclean

# El kernel usa "$<" (no "$^") en arch/riscv32/platformVars, así que añadir
# estos prerequisites no interfiere con el objcopy del kernel.
$(BOOTIMAGE): $(SBL_BIN) $(ULP_BIN)

# Flasheo de las tres imágenes en sus offsets del mapa de memoria del P4:
# SBL @ 0x2000, kernel @ 0x5000, ULP @ 0x400000 (flash de 16 MB).
# El ULP estuvo en 0x100000; se subió a 4 MB para que el kernel crezca sin
# pisarlo (LVGL y lo que viene detrás).  La cota vive en tres sitios que tienen
# que cuadrar: este offset, __ulp_entry_point (machine/sbl/SBL.ld) y el ORIGIN
# de FLASH de machine/ulp/ulp.ld.  `syscheck flash' lo comprueba en placa.
PORT ?= /dev/ttyACM0
BAUD ?= 460800
.PHONY: flash
flash: $(BOOTIMAGE) $(SBL_BIN) $(ULP_BIN)
	$(ESPTOOL) --chip esp32p4 -p $(PORT) -b $(BAUD) \
		--before=default-reset --after=hard-reset \
		write-flash --flash-mode dio --flash-freq 80m --flash-size 16MB \
		0x2000 $(SBL_BIN) 0x5000 $(BOOTIMAGE) 0x400000 $(ULP_BIN)

.PHONY: flashxinu
flashxinu: $(BOOTIMAGE)
	@echo -e "\tFlashing Xinu kernel @ 0x5000"
	$(ESPTOOL) --chip esp32p4 -p $(PORT) -b $(BAUD) \
		--no-stub --before=default-reset --after=hard-reset \
		write-flash --flash-mode dio --flash-freq 80m --flash-size 16MB \
		0x5000 $(BOOTIMAGE)