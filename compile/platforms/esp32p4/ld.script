/**
 * @file ld.script
 *
 * Linker script for Embedded Xinu on the ESP32-P4 (Waveshare
 * ESP32-P4-WIFI6-Touch-LCD-3.5).
 *
 * The SBL (boot loader) sets up the MMU, the cache and the PSRAM, then
 * jumps to __kernel_entry_point (0x40005000) in flash.  From there the
 * kernel runs XiP and copies its .data into the internal L2MEM.
 *
 * Memory regions (from the SDK's Memory_Map.ld):
 *   FLASH(rx)     0x40005000, 31M   -> code + rodata (XiP)
 *   PSRAM(rwx)    0x48000000, 31M   -> shared engine pages, then free heap
 *   HP_L2MEM(rwx) 0x4FF00000, 768K  -> kernel RAM (stack, data, bss)
 *   LP_SRAM       0x50108000, 32K   -> low-power SRAM
 *
 * The P4 MMU has no permission bits (only "valid" + "flash/PSRAM"): all
 * three regions are RWX, and PSRAM is executable.
 */
/* Embedded Xinu, Copyright (C) 2018.  All rights reserved. */

ENTRY(_start)

MEMORY
{
    FLASH(rx)     : ORIGIN = 0x40005000, LENGTH = 31M
    RAM(rwx)      : ORIGIN = 0x48000000, LENGTH = 31M
    HP_L2MEM(rwx) : ORIGIN = 0x4FF00000, LENGTH = 768K
    LP_SRAM(rwx)  : ORIGIN = 0x50108000, LENGTH = 32K
}

/* Peripherals reached through the SDK's struct-mapped headers, copied verbatim
 * from esp32-riscv-bare-metal-sdk-main into include/soc.  Those headers declare
 * each block as an object ("extern sdmmc_dev_t SDMMC;") and the SDK resolves
 * them exactly this way in core/soc/esp32p4/ld/esp32p4.peripherals.ld.  Same
 * addresses, same trick: PROVIDE binds the symbol to the base of the block, so
 * &SDMMC is that base and the headers compile unchanged. */
PROVIDE ( SDMMC             = 0x50083000 );
PROVIDE ( CACHE             = 0x3FF10000 );
PROVIDE ( HP_SYS_CLKRST     = 0x500E6000 );
PROVIDE ( LP_AON_CLKRST     = 0x50111000 );
PROVIDE ( PMU               = 0x50115000 );
PROVIDE ( GPIO              = 0x500E0000 );
PROVIDE ( IO_MUX            = 0x500E1000 );
PROVIDE ( HP_SYSTEM         = 0x500E5000 );
PROVIDE ( LP_SYS            = 0x50110000 );
PROVIDE ( LP_IOMUX          = 0x5012B000 );
PROVIDE ( USB_SERIAL_JTAG   = 0x500D2000 );
PROVIDE ( USB_WRAP          = 0x50080000 );

/* The two ROM pad-router helpers the esp_hosted driver calls.  The SDK binds
 * these names to the boot ROM (core/esp_rom/esp32p4/ld/esp32p4.rom.api.ld:
 * "PROVIDE ( esp_rom_gpio_connect_out_signal = gpio_matrix_out )").  Same
 * binding, but pointed at Xinu's own implementation in device/gpio: it does
 * the identical GPIO-matrix writes and is what W1 proved on this board. */
PROVIDE ( esp_rom_gpio_connect_out_signal = gpio_matrix_out );
PROVIDE ( esp_rom_gpio_connect_in_signal  = gpio_matrix_in  );

SECTIONS
{
    /* ---- flash (XiP) ------------------------------------------------ */
    .init : ALIGN(4)
    {
        KEEP(*(.init))
        KEEP(*(.init.*))
    } > FLASH

    .text : ALIGN(4)
    {
        _text = .;
        *(.text)
        *(.text.*)
        . = ALIGN(4);
    } > FLASH

    .rodata : ALIGN(4)
    {
        *(.rodata)
        *(.rodata.*)
        *(.srodata)
        *(.srodata.*)
        . = ALIGN(4);
    } > FLASH

    .ctors : ALIGN(4)
    {
        __CTOR_LIST__ = .;
        KEEP (*(SORT(.ctors.*)))
        KEEP (*(.ctors))
        KEEP (*(SORT(.init_array.*)))
        KEEP (*(.init_array))
        LONG(-1);
        . = ALIGN(4);
    } > FLASH

    _etext = .;

    /* ---- audio pages (PSRAM, direct-accessed) ------------------------- */
    /* La cadena de descriptores y el anillo de muestras que el AHB-DMA lee
     * para llenar el FIFO TX del I2S0.  Mismo reparto que las paginas del SD:
     * el CPU las escribe por el acceso directo 0x88...... y el motor recibe la
     * forma 0x48......, que es la que el entiende y la unica que cae dentro de
     * su ventana (0x40000000..0x4FFC0000).  Una pagina para los descriptores
     * y dos para las muestras: 8192 bytes = 2048 frames de 4 bytes = 42,7 ms
     * de audio a 48 kHz, que es el anillo maximo.
     *
     * Van antes de .sdshare porque _psram_free_start se define a partir de
     * _sd_block_page: asi el heap de PSRAM siempre arranca por encima de las
     * dos secciones, sean cual sea sus tamanos.
     *
     * Las cuatro paginas siguientes son las dos parejas que comparten el motor
     * por el otro camino: el anillo con el que se reproducen ficheros (el DMA
     * lee) y el de la captura (el DMA escribe).  No salen del heap de PSRAM por
     * lo mismo que las de arriba y las del SD: una peticion de malloc deja su
     * cabecera en la misma linea de cache (128 bytes) que el principio de la
     * lista, y entonces el CPU publica los descriptores por 0x88 mientras el
     * motor los lee por una linea rancia de 0x48; cuando esa linea se expulsa,
     * la imagen vieja pisa lo que ya se habia escrito.  Medido en placa en la
     * E4d: la lista acababa llena de muestras y el motor se aparcaba con un
     * descriptor rechazado.  Con la pagina aparte nadie toca esa linea por la
     * via con cache, asi que no hay nada que mantenga el cache. */
    .audioshare (NOLOAD) : ALIGN(4096)
    {
        _audio_desc_page = .;
        . = . + 4096;
        _audio_buf_page = .;
        . = . + 8192;

        /* Anillo de reproduccion: 32 trozos de 2048 bytes (STREAM_RING_BYTES). */
        _audio_stream_desc_page = .;
        . = . + 4096;
        _audio_stream_buf_page = .;
        . = . + 65536;

        /* Anillo de captura: 32 trozos de 2048 bytes, los mismos que cierra un
         * fin de recepcion del I2S (IN_CHUNK_BYTES). */
        _audio_in_desc_page = .;
        . = . + 4096;
        _audio_in_buf_page = .;
        . = . + 65536;
    } > RAM

    /* ---- accelerator pages (PSRAM, direct-accessed) ------------------ */
    /* Two pages the SD block engine shares with the CPU: the first holds its
     * DMA descriptor, the second the block in transit.  They live in PSRAM
     * because the chip has a documented CPU path to external RAM that skips
     * the cache (0x88..., see sdHw.c), so CPU and engine meet on the same
     * cells with no cache operation in between.  NOLOAD: no image bytes and
     * the boot does not clear them; the driver writes both before use. */
    .sdshare (NOLOAD) : ALIGN(4096)
    {
        _sd_desc_page = .;
        . = . + 4096;
        _sd_block_page = .;
        . = . + 4096;
    } > RAM

    /* ---- internal L2MEM --------------------------------------------- */

    /* Primer trozo de la ventana L2MEM, reservado y nunca usado: ahi NO hay
     * celdas de RAM.  Medido en placa (2026-11-02, barrido de durabilidad cada
     * 8 KB entre 0x4FF00040 y 0x4FF20040): por debajo de 0x4FF20000 una
     * escritura con cache que se desaloja no vuelve (la lectura da 0) y el alias
     * 0x8FF...... tampoco llega a ninguna celda; desde 0x4FF20000 hacia arriba
     * la misma prueba devuelve el valor escrito por los dos caminos.  El hueco
     * mide 128 KB, que es el tamano que declara CACHE_L2_CACHE_CACHESIZE_CONF
     * (0x3FF10278 = 0x200), o sea que ese bloque del array esta consumido por la
     * propia cache L2.  Lo que el kernel tenga aqui solo vive mientras la linea
     * este residente: cualquier desalojo lo borra, y asi se pierden las tablas,
     * el pwd del FAT o el estado de un driver.  Reservar 128 KB en vez de la
     * pagina de 4 KB que antes bastaba cuesta memoria, pero deja .data, .bss y
     * el heap de L2MEM encima del corte, en RAM de verdad. */
    .l2reserve (NOLOAD) : ALIGN(4096)
    {
        _l2reserve = .;
        . = . + 0x20000;
    } > HP_L2MEM

    /* CLIC hardware vector table (NOLOAD): filled at runtime by the
     * interrupt controller before any line is unmasked.  aligned(64). */
    .vectors (NOLOAD) : ALIGN(64)
    {
        KEEP(*(.vectors))
        . = ALIGN(64);
    } > HP_L2MEM

    /* Initialized data: stored in flash, copied to L2MEM at boot */
    .data : ALIGN(4)
    {
        _sdata = .;
        _data_start = .;
        *(.data)
        *(.data.*)
        . = ALIGN(4);
        __global_pointer$ = . + 0x800;

        *(.sdata)
        *(.sdata.*)
        _edata = .;
        _data_end = .;
    } > HP_L2MEM AT>FLASH

    _data_loadaddr = LOADADDR(.data);

    /* Uninitialized data: L2MEM only */
    .bss : ALIGN(4)
    {
        _sbss = .;
        _bss_start = .;
        *(.bss)
        *(.bss.*)
        *(.sbss)
        *(.sbss.*)
        *(COMMON)
        _ebss = .;
        _bss_end = .;
    } > HP_L2MEM

    /* Stack del core1 (NOLOAD): la usa sólo el bucle de aparcado de
     * loader/platforms/esp32p4/start.S.  Sección aparte, detrás de .bss y
     * antes de _end, por dos motivos: el borrado de .bss que hace core0 no la
     * toca (el core1 escribe su testigo ahí), y el heap de L2MEM arranca por
     * encima, así que nunca se solapa con él. */
    .core1stk (NOLOAD) : ALIGN(16)
    {
        _core1stk = .;
        . = . + 2048;
        _core1stk_end = .;
    } > HP_L2MEM

    _end = .;

    /* Free L2MEM: Xinu heap (thread stacks, buffers).  Starts right after
     * the reserved regions above.  It stops well below the top of the
     * region: the last 64 KB belong to the boot ROM, which keeps its cache
     * dispatch table at 0x4FFBFFD8 and its boot stack at 0x4FFBCFC0
     * (SOC_ROM_STACK_START_REV2).  Xinu hands out thread stacks from the
     * top of the heap, so without this the first stack lands on the ROM's
     * data and every ROM call that goes through the table dies. */
    _l2mem_free_start = _end;
    _l2mem_free_end   = 0x4FFB0000;

    /* PSRAM: free from the end of the shared pages up. */
    _psram_free_start = _sd_block_page + 4096;
    _psram_free_end   = ORIGIN(RAM) + LENGTH(RAM);

    /DISCARD/ : {
        *(.comment .comment.* .note .note.*)
        *(.eh_frame)
    }
}
