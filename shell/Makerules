# This Makefile contains rules to build files in the shell/ directory.

# Name of this component (the directory this file is stored in)
COMP = shell

# Source files for this component
C_FILES = shell.c lexan.c getopt.c fsutil.c lcd_cube.c lcd_plasma.c 


# General shell commands
C_FILES += xsh_clear.c xsh_date.c xsh_echo.c xsh_exit.c xsh_help.c \
           xsh_reset.c xsh_sleep.c xsh_uptime.c

# Processes commands
C_FILES += xsh_kill.c xsh_ps.c xsh_sem.c xsh_mon.c xsh_stack.c xsh_ktest.c

# Memory commands
C_FILES += xsh_memdump.c xsh_mem.c xsh_psram.c

# UART commands
C_FILES += xsh_uartstat.c

# Display commands
C_FILES += xsh_lcd.c

# Bus / low-level control commands (I2C master bus, GPIO pins, touch panel,
# PMIC battery gauge, audio codec)
C_FILES += xsh_i2c.c xsh_gpio.c xsh_touchpanel.c xsh_power.c xsh_audio.c

# Boot-time dashboard task (main.c spawns it after bootTask)
C_FILES += xsh_dash.c p4demoTask.c rec.c

# Storage commands
C_FILES += xsh_sd.c

# WiFi over the ESP32-C6 (SDIO slot 1 del host compartido)
C_FILES += xsh_wifi.c xsh_wifi_scan.c

# Red: la pila TCP/IP nativa de Xinu sube/baja la interfaz ETH0 (el C6 como
# NIC) y 'ping' prueba la conectividad end-to-end.  Los de estado son los
# comando de red de xinu-s3-amp: arp/netstat/route/ifconfig miran arptab[],
# netiftab[] y rttab[]; tcpstat/udpstat recorren tcptab[]/udptab[]; 'dns'
# resuelve un nombre por el UDP0 contra 8.8.8.8.
C_FILES += xsh_netup.c xsh_netdown.c xsh_ping.c xsh_arp.c xsh_route.c \
           xsh_netstat.c xsh_ifconfig.c xsh_tcpstat.c xsh_udpstat.c xsh_dns.c

# Servidores: 'telnetserver' arranca los hilos de sesion sobre device/telnet
# (un TELNETn por cliente, con su shell) y 'telnet' es el cliente hacia otra
# maquina.  'telnetd' es el alias de siempre.
C_FILES += xsh_telnet.c xsh_telnetserver.c xsh_telnetd.c

# 'httpd' es el servidor HTTP: escucha en el 80 con la pila TCP nativa y
# sirve los ficheros de la microSD, con la pagina embebida como respaldo de
# /index.html.  `httpapi.c' es la API REST de ficheros que el mismo servidor
# despacha para las rutas /api/ (lista, descarga, PUT/DELETE, mkdir, rmdir);
# es el puerto de la de xinu-s3-amp sin /api/exec y /api/job, que dependen de
# webterm y aqui todavia no tienen donde apoyarse.
C_FILES += xsh_httpd.c httpapi.c

# 'udpserver' es el servidor de comandos por UDP y la puerta de entrada del
# firmware: un dispositivo UDP en modo pasivo (read() trae el pseudo-header, o
# sea el origen de la consulta), familia de comandos de texto y la sesion
# FW_BEGIN/FW_DATA/FW_END/FW_ABORT/FW_STATUS que apila la imagen en
# /xinu.tmp de la SD y la deja en /xinu.img.  La aplicacion real a flash sigue
# bloqueada en este puerto (documento 05 §6): no hay driver de escritura ni de
# borrado de la flash y el SBL no lee la tarjeta.
C_FILES += xsh_udpserver.c

# Arranque automatico de red (lo invoca main.c como tarea, y tambien es el
# comando `netboot' para reintentarlo a mano).
C_FILES += xsh_netboot.c

# Filesystem commands (FAT volume on the microSD)
C_FILES += xsh_pwd.c xsh_cd.c xsh_ls.c xsh_cat.c xsh_head.c xsh_tail.c \
           xsh_cp.c xsh_mv.c xsh_rm.c xsh_mkdir.c xsh_rmdir.c xsh_stat.c \
           xsh_df.c xsh_format.c xsh_hexdump.c xsh_touch.c xsh_test.c

# Apps ELF: 'elf' carga un .elf de la microSD, le aplica la tabla de exports y
# lo ejecuta (en hebra propia por defecto, o con '--aqui' en la hebra del
# comando; en ambos casos la PSRAM del app queda libre al terminar).  El
# cargador en si vive en system/elfload.c (include/elfload.h) y el comando es
# su cliente.
C_FILES += xsh_elf.c

# 'syscheck' es la comprobacion del kernel (clk/cpu/mem/net/dev/int/flash/stk).
# La referencia externa, el guion del PC (p4clk.py) y como leer cada cifra se
# quedan en examples/syscheck/ y en docs/port-esp32p4/06-syscheck.md.
C_FILES += xsh_syscheck.c

# 'java' (xsh_java.c) se va con la pila grafica aparcada: esta en
# parked/java-gui/shell/.  Sin jvm/ ni device/jvm enlazados no tiene nada
# que llamar.


S_FILES =

# Add the files to the compile source path
DIR = ${TOPDIR}/${COMP}
COMP_SRC += ${S_FILES:%=${DIR}/%} ${C_FILES:%=${DIR}/%}
